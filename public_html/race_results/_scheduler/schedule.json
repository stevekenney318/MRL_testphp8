{
  "enabled": true,
  "timezone": "America/New_York",
  "year": 2026,
  "dry_run": false,
  "notes": [
    "Place this file at race_results/_scheduler/schedule.json.",
    "Scripts are relative to the folder containing cron_master_scheduler.php.",
    "One Hostinger cron can call cron_master_scheduler.php every minute."
  ],
  "tasks": {
    "race_results_monitor": {
      "enabled": true,
      "type": "interval",
      "script": "race_results_monitor.php",
      "args": [
        "{{year}}"
      ],
      "interval_minutes": 60,
      "lock_minutes": 10,
      "timeout_seconds": 300,
      "windows": {
        "race_day": {
          "enabled": true,
          "days": [
            7
          ],
          "start": "12:00",
          "end": "18:59",
          "interval_minutes": 15
        },
        "race_start_watch": {
          "enabled": true,
          "days": [
            7
          ],
          "start": "19:00",
          "end": "21:29",
          "interval_minutes": 5
        },
        "race_finish_watch_1": {
          "enabled": true,
          "days": [
            7
          ],
          "start": "21:30",
          "end": "22:29",
          "interval_minutes": 2
        },
        "race_finish_watch_2": {
          "enabled": true,
          "days": [
            7
          ],
          "start": "22:30",
          "end": "23:59",
          "interval_minutes": 1
        },
        "race_finish_watch_3": {
          "enabled": true,
          "days": [
            1
          ],
          "start": "00:00",
          "end": "01:00",
          "interval_minutes": 1
        }
      }
    },
    "race_results_revision_monitor": {
      "enabled": true,
      "type": "daily_times",
      "script": "race_results_revision_monitor.php",
      "args": [
        "{{year}}"
      ],
      "times": [
        "00:00",
        "12:00"
      ],
      "lock_minutes": 30,
      "timeout_seconds": 600
    }
  }
}
